# 2. Clean numeric columns
#    removing '<'
#    replacing ',' with '.'
#    converting to float

categorical_cols = [
    "Reservior", "Year", "Month", "Site", "Date",
    "Escherichia coli", "Ecotoxicological Test with Ceriodaphnia dubia",
    "Color", "Rainfall in the last 24 h",
]

numeric_cols = [c for c in df_raw.columns if c not in categorical_cols]

def clean_numeric(x):
    if pd.isna(x):
        return np.nan
    x = str(x).strip()
    x = x.replace("<", "")        # censor sign
    x = x.replace(",", ".")       # decimal comma
    x = x.replace(" ", "")
    if x in ["", "-", "--", "nan", "NaN"]:
        return np.nan
    try:
        return float(x)
    except Exception:
        return np.nan

df = df_raw
for col in numeric_cols:
    df[col] = df[col].apply(clean_numeric)

