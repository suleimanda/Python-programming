####### Function to fit a model for one arm (A + B)#####

def fit_arm_model(df_arm, arm_name):
    X_num = df_arm[all_features] # numeric features
    X_cat = pd.get_dummies(df_arm[["Year"]], drop_first=True) # year dummy only (month encoded cyclically)
    X_full = pd.concat([X_num, X_cat], axis=1)
    y = df_arm["Chlorophyll-a"]
    df_ml = pd.concat([X_full, y], axis=1).dropna(subset=all_features + ["Chlorophyll-a"])
    X = df_ml.drop(columns=["Chlorophyll-a"])
    y = df_ml["Chlorophyll-a"].astype(float)
    print(f"\n=== {arm_name} ===")
    print("Rows used:", len(df_ml))

    # -------- log-target model --------
    y_log = np.log1p(y)
    X_train, X_test, y_train_log, y_test_log = train_test_split(
        X, y_log, test_size=0.2, random_state=RANDOM_STATE)
    gb_log = HistGradientBoostingRegressor(
        max_depth=3,
        learning_rate=0.05,
        max_iter=400,
        min_samples_leaf=10,
        l2_regularization=0.1,
        random_state=RANDOM_STATE,
    )
    gb_log.fit(X_train, y_train_log)

    pred_log = gb_log.predict(X_test)
    y_test_orig = np.expm1(y_test_log)
    pred_orig = np.expm1(pred_log)

    rmse_log = np.sqrt(mean_squared_error(y_test_log, pred_log))
    r2_log = r2_score(y_test_log, pred_log)
    mae_log = mean_absolute_error(y_test_log, pred_log)

    rmse_orig = np.sqrt(mean_squared_error(y_test_orig, pred_orig))
    r2_orig = r2_score(y_test_orig, pred_orig)
    mae_orig = mean_absolute_error(y_test_orig, pred_orig)

    print("Log-target model:")
    print(f"  LOG  -> RMSE = {rmse_log:.3f}, R2 = {r2_log:.3f}, MAE = {mae_log:.3f}")
    print(f"  Orig -> RMSE = {rmse_orig:.3f}, R2 = {r2_orig:.3f}, MAE = {mae_orig:.3f}")

    # -------- robust original-target model --------
    X_train_o, X_test_o, y_train_o, y_test_o = train_test_split(
        X, y, test_size=0.2, random_state=RANDOM_STATE
    )

    gb_orig = HistGradientBoostingRegressor(
        loss="absolute_error",
        max_depth=3,
        learning_rate=0.05,
        max_iter=400,
        min_samples_leaf=10,
        l2_regularization=0.1,
        random_state=RANDOM_STATE,
    )
    gb_orig.fit(X_train_o, y_train_o)

    pred_o = gb_orig.predict(X_test_o)

    rmse_o = np.sqrt(mean_squared_error(y_test_o, pred_o))
    r2_o = r2_score(y_test_o, pred_o)
    mae_o = mean_absolute_error(y_test_o, pred_o)

    print("Original-target abs-loss model:")
    print(f"  RMSE = {rmse_o:.3f}, R2 = {r2_o:.3f}, MAE = {mae_o:.3f}")

    return {
        "X_train": X_train,
        "X_test": X_test,
        "y_train_log": y_train_log,
        "y_test_log": y_test_log,
        "y_test_orig": y_test_orig,
        "pred_log": pred_log,
        "pred_orig": pred_orig,
        "gb_log": gb_log,
        "X_train_o": X_train_o,
        "X_test_o": X_test_o,
        "y_train_o": y_train_o,
        "y_test_o": y_test_o,
        "pred_o": pred_o,
        "gb_orig": gb_orig,
        "features": X.columns,
    }
